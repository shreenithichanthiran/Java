import java.util.Scanner;
public class Q1 {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int performanceRating = sc.nextInt();
        int yearsOfService = sc.nextInt();
        String departmentType = sc.next();
        double baseSalary = sc.nextDouble();

        int bonusPercentage = 0;
        String status = "Not Eligible";

        if (performanceRating >= 4) {

            if (yearsOfService >= 5) {

                if (departmentType.equals("Critical")) {
                    bonusPercentage = 25;
                    status = "Eligible";
                } else {
                    bonusPercentage = 20;
                    status = "Eligible";
                }

            } else {
                if (departmentType.equals("Critical")) {
                    bonusPercentage = 15;
                    status = "Eligible";
                } else {
                    bonusPercentage = 10;
                    status = "Eligible";
                }
            }

        } else if (performanceRating == 3) {

            if (yearsOfService >= 2) {

                if (departmentType.equals("Critical")) {
                    bonusPercentage = 10;
                    status = "Eligible";
                } else {
                    bonusPercentage = 8;
                    status = "Eligible";
                }

            } else {
                bonusPercentage = 0;
                status = "Not Eligible";
            }

        } else {

            bonusPercentage = 0;
            status = "Not Eligible";
        }
        double bonusAmount = baseSalary * bonusPercentage / 100;

        System.out.println("Performance Rating: " + performanceRating);
        System.out.println("Years of Service: " + yearsOfService);
        System.out.println("Department: " + departmentType);
        System.out.println("Bonus Percentage: " + bonusPercentage + "%");
        System.out.println("Bonus Amount: $" + bonusAmount);
        System.out.println("Status: " + status);

        sc.close();
    }
}
